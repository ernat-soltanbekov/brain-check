# Empty URL = offline mock. Never commit a real key or your .env.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# For local Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a long random value and DEBUG=false before deployment.
DJANGO_SECRET_KEY=
